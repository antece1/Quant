  </array>
  <key>WorkingDirectory</key><string>/Users/antaiwei/Claude Code</string>
  <key>StandardOutPath</key><string>/Users/antaiwei/Claude Code/premkt/logs/launchd_scan.out</string>
  <key>StandardErrorPath</key><string>/Users/antaiwei/Claude Code/premkt/logs/launchd_scan.err</string>
